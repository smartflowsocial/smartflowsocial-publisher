{
  "name": "nostr-publisher",
  "version": "0.0.0",
  "description": "HTTP publisher for SmartFlowSocial. Accepts signed Nostr events and publishes them to relays.",
  "author": "SmartFlowSocial",
  "license": "Unlicense",
  "homepage": "https://smartflow.social",
  "repository": {
    "type": "git",
    "url": "https://github.com/smartflowsocial/smartflowsocial-publisher.git"
  },
  "bugs": {
    "url": "https://github.com/smartflowsocial/smartflowsocial-publisher/issues"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.13.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^65.0.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "3.10.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^5.1.0",
    "wrangler": "4.164.0",
    "ws": "^8.23.0"
  },
  "private": true,
  "scripts": {
    "prepare": "husky",
    "build": "pnpm run typecheck && wrangler deploy --dry-run",
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "lint:fix": "eslint --fix .",
    "lint:ci": "eslint . --format json --output-file eslint-report.json || exit 1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck",
    "precheck": "pnpm lint && pnpm typecheck",
    "test": "vitest run",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:unit": "vitest run tests/core tests/policies tests/adapters",
    "test:integration": "vitest run tests/transport",
    "test:chaos": "vitest run tests/chaos",
    "test:property": "vitest run tests/property",
    "test:security": "vitest run tests/security",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "bech32": "^2.0.0",
    "nostr-tools": "^2.26.1",
    "valibot": "^1.5.0"
  },
  "lint-staged": {
    "*.{ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
